# fields for the database
config_set: 'Monongalia_County_WV_driving_original_configs' #should match folder name
config_name: 'config_template_Monongalia_log_drive' #should match file name

# Constants for the optimization function
location: 'Monongalia_County_WV'
census_year: '2020'
year:
    - '2026'
bad_types:
    - 'bg_centroid'
beta: -1
time_limit: 360000 #100 hours minutes
limits_gap: 0.02
capacity: 1.2
fixed_capacity_site_number: null

####Optional#####
precincts_open: null
max_min_mult: 5 #scalar >= 1
maxpctnew: 0 # in interval [0,1]
minpctold: 1 # in interval [0,1]
driving: True
metric: driving_distance # haversine | driving_distance | driving_time
log_distance: True
penalized_sites: null

###### For config generation ######
field_to_vary: 'metric'
new_range:
    - 'driving_distance'
    - 'driving_time'
