{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,

    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gcloud",
        "~/Documents",
        "~/Downloads",
        "~/Desktop",
        "~/Pictures",
        "~/Library",
        "~/AppData"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.zshrc",
        "~/.bashrc",
        "~/.config/gcloud",
        "~/.claude",
        "/etc",
        "/opt/conda/envs/equitable-polls"
      ],
      "allowWrite": [".", "/tmp"]
    },

    "network": {
      "allowedDomains": [
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "api.github.com",
        "api.anthropic.com",
        "*.anthropic.com",
        "code.claude.com",
        "*.googleapis.com",
        "*.gstatic.com",
        "accounts.google.com",
        "oauth2.googleapis.com"
      ]
    },

    "excludedCommands": [
      "pylsp",
      "pyright",
      "pyright-langserver",
      "jedi-language-server",
      "ruff"
    ]
  },

  "permissions": {
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(rm -rf /*)",
      "Bash(chmod -R 777*)",
      "Bash(chown *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pylint *)",
      "Bash(pytest *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git remote *)",
      "Bash(git switch *)"
    ]
  }
}
